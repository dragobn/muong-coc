<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
 <Document>
  <name>Từ Bản Mường đến Động Hương Tích</name>
  <description>Tuyến tự động dựng bằng OSRM (cycling). 4 điểm dừng. . CẢNH BÁO: route có thể bám đường lớn (Hồ Chí Minh) — kiểm tra và chỉnh trong My Maps để bám đường dân sinh.</description>
  <Style id="stop"><IconStyle><color>ff3ba300</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-blank.png</href></Icon></IconStyle></Style>
  <Style id="stopact"><IconStyle><color>ff0a78ff</color><scale>1.0</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/orange-blank.png</href></Icon></IconStyle></Style>
  <Style id="route"><LineStyle><color>ff2f6a0a</color><width>5</width></LineStyle></Style>
  <Placemark><name>Tuyến Từ Bản Mường đến Động Hương Tích (OSRM cycling — kiểm tra tránh đường HCM)</name><styleUrl>#route</styleUrl><LineString><tessellate>1</tessellate><coordinates>105.690182,20.622672,0 105.690351,20.62237,0 105.6913,20.620788,0 105.69203,20.619564,0 105.692877,20.618093,0 105.693337,20.617288,0 105.693515,20.616965,0 105.693562,20.61688,0 105.693791,20.616401,0 105.694075,20.61556,0 105.694322,20.61453,0 105.694793,20.612205,0 105.695046,20.610921,0 105.695344,20.6095,0 105.695965,20.606561,0 105.696448,20.604131,0 105.69647,20.604021,0 105.696969,20.601577,0 105.698108,20.602462,0 105.698247,20.602603,0 105.698281,20.602647,0 105.698846,20.603492,0 105.699182,20.603848,0 105.69969,20.603633,0 105.700201,20.603022,0 105.701263,20.603969,0 105.7031,20.605793,0 105.703644,20.606331,0 105.704512,20.606612,0 105.704598,20.606651,0 105.70501,20.606836,0 105.705133,20.606892,0 105.705988,20.606917,0 105.706129,20.607005,0 105.706305,20.607201,0 105.706378,20.607468,0 105.706415,20.60773,0 105.706486,20.607807,0 105.706987,20.608307,0 105.707327,20.609365,0 105.707816,20.609795,0 105.70786,20.609804,0 105.70816,20.609818,0 105.709589,20.609479,0 105.709635,20.60946,0 105.710272,20.60919,0 105.711232,20.608734,0 105.71253,20.608348,0 105.712565,20.608338,0 105.714516,20.607288,0 105.715687,20.606953,0 105.716658,20.606573,0 105.718273,20.605983,0 105.719655,20.605537,0 105.721235,20.604457,0 105.72147,20.604605,0 105.721597,20.604741,0 105.72187,20.604992,0 105.722154,20.60522,0 105.722578,20.605604,0 105.722975,20.606003,0 105.72318,20.606252,0 105.723213,20.606287,0 105.723242,20.606307,0 105.72328,20.606307,0 105.72332,20.606273,0 105.723371,20.606207,0 105.723442,20.606098,0</coordinates></LineString></Placemark>
  <Placemark><name>1. Khám phá văn hoá Mường &amp; đêm lửa trại</name><description>Ngày 1 — Bạn trải nghiệm theo chương trình Tour 1 ngày (Phương án A hoặc B): chùa Phú Cốc, đền Cây Thợi, hồ Baibóo và các homestay, bữa trưa cỗ Mường, giao lưu văn nghệ. Tối quây quần bên lửa trại, nghe hát ca Mường và Mo Mường, thư giãn ngâm chân lá thuốc. Nghỉ đêm tại homestay cộng đồng.</description><styleUrl>#stop</styleUrl><Point><coordinates>105.6897842,20.6224767,0</coordinates></Point></Placemark>
  <Placemark><name>2. Hành trình tâm linh &amp; sông nước</name><description>Ngày 2 — Ban ngày — Thăm Vườn Sim Cổ và Rượu Sim; chiêm bái Chùa Đinh Long (dấu vua Đinh Bộ Lĩnh, dấu ấn kháng chiến); đạp xe qua con đường tràm 800 m; leo bậc đá lên Chùa Tiên (thôn Ái Nàng — phát hiện 1958, nhũ đá hoang sơ); ghé đền Mẫu Thượng Thiên bên dòng sông.</description><styleUrl>#stopact</styleUrl><Point><coordinates>105.6897842,20.6224767,0</coordinates></Point></Placemark>
  <Placemark><name>3. Trò chơi dân gian &amp; ngâm chân lá thuốc</name><description>Ngày 2 — Tối — Bạn tham gia các trò chơi dân gian Mường (ném còn, đánh mảng, đẩy gậy) trong tiếng cười rộn ràng, rồi thư giãn với một chậu ngâm chân lá thuốc trước khi nghỉ đêm thứ hai tại homestay cộng đồng.</description><styleUrl>#stopact</styleUrl><Point><coordinates>105.6897842,20.6224767,0</coordinates></Point></Placemark>
  <Placemark><name>4. Trekking động Hương Tích</name><description>Ngày 3 — Trekking chinh phục động Hương Tích (~4 giờ) — bạn theo chân người dẫn đường địa phương vượt núi rừng lên động Hương Tích, chiêm bái điểm đến tâm linh nổi tiếng và thu vào tầm mắt khung cảnh non nước kỳ vĩ. Sau khi xuống núi, bạn nghỉ ngơi, chia tay bản Mường.</description><styleUrl>#stop</styleUrl><Point><coordinates>105.7389,20.6098,0</coordinates></Point></Placemark>
 </Document>
</kml>