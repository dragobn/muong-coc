<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
 <Document>
  <name>Xanh Giữa Lòng Mường Cốc</name>
  <description>Tuyến tự động dựng bằng OSRM (cycling). 8 điểm dừng. ~12 – 14 km. CẢNH BÁO: route có thể bám đường lớn (Hồ Chí Minh) — kiểm tra và chỉnh trong My Maps để bám đường dân sinh.</description>
  <Style id="stop"><IconStyle><color>ff3ba300</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-blank.png</href></Icon></IconStyle></Style>
  <Style id="stopact"><IconStyle><color>ff0a78ff</color><scale>1.0</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/orange-blank.png</href></Icon></IconStyle></Style>
  <Style id="route"><LineStyle><color>ff2f6a0a</color><width>5</width></LineStyle></Style>
  <Placemark><name>Tuyến Xanh Giữa Lòng Mường Cốc (OSRM cycling — kiểm tra tránh đường HCM)</name><styleUrl>#route</styleUrl><LineString><tessellate>1</tessellate><coordinates>105.690182,20.622672,0 105.689987,20.623021,0 105.689867,20.62321,0 105.689547,20.623793,0 105.689263,20.624422,0 105.689131,20.624812,0 105.689099,20.624889,0 105.688862,20.625535,0 105.688624,20.626025,0 105.688446,20.626281,0 105.688246,20.626486,0 105.687964,20.626705,0 105.68768,20.626879,0 105.68735,20.627,0 105.687076,20.627066,0 105.686759,20.62713,0 105.686177,20.627161,0 105.685781,20.627231,0 105.68541,20.627346,0 105.684744,20.626255,0 105.684578,20.625934,0 105.684448,20.625653,0 105.684317,20.625302,0 105.684286,20.625187,0 105.684197,20.624777,0 105.684154,20.62458,0 105.684106,20.624302,0 105.684097,20.624246,0 105.68405,20.623897,0 105.68392,20.622913,0 105.683889,20.622543,0 105.683876,20.622466,0 105.683854,20.622414,0 105.683823,20.622362,0 105.683682,20.622188,0 105.684325,20.622214,0 105.684848,20.621577,0 105.684876,20.621524,0 105.684881,20.621465,0 105.684874,20.621405,0 105.684846,20.62136,0 105.684801,20.621327,0 105.684747,20.621302,0 105.684549,20.621243,0 105.684525,20.621224,0 105.684508,20.62119,0 105.684472,20.620851,0 105.684484,20.620804,0 105.684529,20.620743,0 105.684742,20.620557,0 105.684529,20.620743,0 105.684484,20.620804,0 105.684472,20.620851,0 105.684508,20.62119,0 105.684525,20.621224,0 105.684549,20.621243,0 105.684747,20.621302,0 105.684801,20.621327,0 105.684846,20.62136,0 105.684874,20.621405,0 105.684877,20.621427,0 105.684881,20.621465,0 105.684876,20.621524,0 105.684848,20.621577,0 105.684325,20.622214,0 105.683682,20.622188,0 105.683823,20.622362,0 105.683854,20.622414,0 105.683876,20.622466,0 105.683889,20.622543,0 105.68392,20.622913,0 105.68405,20.623897,0 105.684097,20.624246,0 105.684106,20.624302,0 105.684154,20.62458,0 105.684197,20.624777,0 105.684286,20.625187,0 105.684317,20.625302,0 105.684448,20.625653,0 105.684578,20.625934,0 10